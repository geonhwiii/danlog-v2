    "@astrojs/mdx": "^8.1.2",
    "@astrojs/react": "^7.1.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/noto-serif-kr": "^5.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.4",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.66.0",
    "overlay-kit": "^1.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "nano-staged": "^1.0.2",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "rehype-pretty-code": "^0.14.5",
    "shiki": "^4.6.0",
    "simple-git-hooks": "^2.14.0"
