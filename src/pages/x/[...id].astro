---
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";
import XThread from "../../components/x/XThread.astro";
import { formatLongDate, getXEntries, summaryOf, type XEntry } from "@lib/x";

// Opened from a home row: the chosen thread first, then every older one
// stacked below it, so the page reads on like a feed.
export async function getStaticPaths() {
  const entries = await getXEntries();
  return entries.map((entry, i) => ({ params: { id: entry.id }, props: { entry, following: entries.slice(i + 1) } }));
}

const { entry, following } = Astro.props as { entry: XEntry; following: XEntry[] };
const { post, date } = entry.data;
---

<Layout title={`@${post.author.handle}의 X`} description={summaryOf(entry).slice(0, 140)}>
  <main class="mx-auto max-w-[648px] px-6 pt-[clamp(24px,5vw,48px)] pb-14">
    <div class="flex items-center gap-1 font-sans text-sm leading-snug text-muted">
      <a
        href="/#x"
        aria-label="홈으로 돌아가기"
        class="-ml-2.5 grid size-10 flex-none place-items-center rounded-full text-ink transition-colors hover:bg-surface-strong"
      >
        <svg
          aria-hidden="true"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M19 12H5M12 19l-7-7 7-7"></path>
        </svg>
      </a>
      <span class="flex gap-2">
        <span>X</span>
        <span aria-hidden="true">·</span>
        <time datetime={date.toISOString()}>{formatLongDate(date)}</time>
      </span>
    </div>

    <ol class="mt-4 flex flex-col gap-6">
      <li>
        <XThread entry={entry} />
      </li>
      {
        following.map((next) => (
          <li id={next.id} class="scroll-mt-6">
            <XThread entry={next} />
          </li>
        ))
      }
    </ol>

    <Footer back={{ href: "/#x", label: "← 홈" }} />
  </main>
</Layout>
