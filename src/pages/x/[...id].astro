---
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";
import XThread from "../../components/x/XThread.astro";
import { formatLongDate, getXEntries, summaryOf, type XEntry } from "@lib/x";

// Share link for a single X entry. On the home page the same thread opens in place.
export async function getStaticPaths() {
  const entries = await getXEntries();
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: XEntry };
const { post, date } = entry.data;
---

<Layout title={`@${post.author.handle}의 X`} description={summaryOf(entry).slice(0, 140)}>
  <main class="mx-auto max-w-[648px] px-6 pt-[clamp(24px,5vw,48px)] pb-14">
    <div class="flex items-center gap-1 font-sans text-sm leading-snug text-muted">
      <a
        href="/#x"
        aria-label="홈으로 돌아가기"
        class="-ml-2.5 grid size-10 flex-none place-items-center rounded-full text-ink transition-colors hover:bg-surface-strong"
      >
        <svg
          aria-hidden="true"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M19 12H5M12 19l-7-7 7-7"></path>
        </svg>
      </a>
      <span class="flex gap-2">
        <span>X</span>
        <span aria-hidden="true">·</span>
        <time datetime={date.toISOString()}>{formatLongDate(date)}</time>
      </span>
    </div>

    <div class="mt-4">
      <XThread entry={entry} />
    </div>

    <Footer back={{ href: "/#x", label: "← 홈" }} />
  </main>
</Layout>
