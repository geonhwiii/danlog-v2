---
import Layout from "../../layouts/Layout.astro";
import BackLink from "../../components/BackLink.astro";
import Footer from "../../components/Footer.astro";
import XThread from "../../components/x/XThread.astro";
import { getXEntries, summaryOf, type XEntry } from "@lib/x";

// Every X page is the whole feed, newest first; the page for a given entry
// opens scrolled to that entry, the way a tapped post opens in X's timeline.
export async function getStaticPaths() {
  const entries = await getXEntries();
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry, entries } }));
}

const { entry, entries } = Astro.props as { entry: XEntry; entries: XEntry[] };
---

<Layout title={`@${entry.data.post.author.handle}의 X`} description={summaryOf(entry).slice(0, 140)}>
  <main class="mx-auto max-w-[648px] px-6 pb-14">
    <div
      data-x-bar
      class="sticky top-0 z-10 -mx-6 flex items-center gap-1 bg-canvas/90 px-6 py-2 font-sans text-sm leading-snug text-ink backdrop-blur"
    >
      <BackLink href="/#x" label="홈으로 돌아가기" />
      <span class="font-semibold">X</span>
    </div>

    <ol data-x-feed data-current={entry.id} class="mt-[clamp(8px,3vw,24px)] flex flex-col gap-6">
      {
        entries.map((item) => (
          <li id={item.id} aria-current={item.id === entry.id ? "true" : undefined}>
            <XThread entry={item} />
          </li>
        ))
      }
    </ol>

    <Footer back={{ href: "/#x", label: "← 홈" }} />

    {/* Runs during parsing, once the whole page is in, so the page is already at
        the tapped entry on first paint. Position is kept as an anchor — which
        entry is at the top and how far into it — not a pixel offset, because
        heights above can still change (web fonts, cards rendered lazily). */}
    <script is:inline>
      (() => {
        const feed = document.querySelector("[data-x-feed]");
        const bar = document.querySelector("[data-x-bar]");
        history.scrollRestoration = "manual";

        const top = () => bar.offsetHeight + 12;
        const anchorNow = () => {
          const line = top();
          const card = [...feed.children].find((li) => li.getBoundingClientRect().bottom > line) ?? feed.firstElementChild;
          return { id: card.id, delta: line - card.getBoundingClientRect().top };
        };
        const pin = ({ id, delta }) => {
          const card = document.getElementById(id);
          if (card) window.scrollBy(0, card.getBoundingClientRect().top - (top() - delta));
        };

        // Back/forward and reload return to where the reader was; a fresh
        // visit starts at the tapped entry.
        const anchor = history.state?.xAnchor ?? { id: feed.dataset.current, delta: 0 };
        pin(anchor);

        // Re-pin while the layout settles, until the reader takes over.
        const settle = new ResizeObserver(() => pin(anchor));
        settle.observe(document.body);
        const release = () => {
          settle.disconnect();
          for (const type of ["wheel", "touchstart", "keydown", "pointerdown"]) removeEventListener(type, release);
        };
        for (const type of ["wheel", "touchstart", "keydown", "pointerdown"]) {
          addEventListener(type, release, { passive: true });
        }
        document.fonts.ready.then(() => requestAnimationFrame(() => (pin(anchor), setTimeout(release, 500))));

        // Remember the anchor once scrolling stops (and on leave) for restoring.
        const save = () => history.replaceState({ ...history.state, xAnchor: anchorNow() }, "");
        let timer = 0;
        addEventListener("scroll", () => (clearTimeout(timer), (timer = setTimeout(save, 150))), { passive: true });
        addEventListener("pagehide", save);
      })();
    </script>
  </main>
</Layout>

<style>
  /* Cards off screen skip rendering — CSS's take on feed virtualization.
     `auto` keeps each card's last measured height once it has been seen. */
  [data-x-feed] > li:not([aria-current]) {
    content-visibility: auto;
    contain-intrinsic-size: auto 560px;
  }
</style>
