---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import HomePainting from "../components/HomePainting.astro";
import { site } from "@shared/constants";

const posts = (await getCollection("blog", ({ data }) => !data.draft && data.visible)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const formatMonth = new Intl.DateTimeFormat("ko-KR", { year: "numeric", month: "long" }).format;
---

<Layout>
  <div
    class="mx-auto flex max-w-[1100px] items-start justify-center gap-[clamp(48px,9vw,120px)] px-6 pt-[clamp(40px,6vw,64px)] pb-14"
  >
    <main class="min-w-0 flex-[0_1_600px]">
      <h1 class="text-[36px] leading-tight font-semibold tracking-[-0.01em] text-ink">{site.handle}</h1>

      <div class="mt-12 border-b border-hairline pb-2.5 font-sans text-sm leading-snug text-muted">소개</div>
      <p class="mt-6">{site.bio}</p>

      <section class="mt-20" aria-labelledby="posts-heading">
        <h2 id="posts-heading" class="mb-5 text-[24px] leading-snug font-semibold text-ink">글</h2>
        {
          posts.length > 0 ? (
            <ol class="border-t border-hairline">
              {posts.map((post) => (
                <li class="border-b border-hairline">
                  <a
                    href={`/blog/${post.id}`}
                    class="group flex flex-col items-start py-3.5 text-ink no-underline sm:flex-row sm:items-baseline sm:justify-between sm:gap-6"
                  >
                    <span class="min-w-0 leading-relaxed decoration-1 underline-offset-[0.26em] group-hover:underline">
                      {post.data.title}
                    </span>
                    <time
                      datetime={post.data.date.toISOString()}
                      class="flex-none font-sans text-sm whitespace-nowrap text-muted tabular-nums"
                    >
                      {formatMonth(post.data.date)}
                    </time>
                  </a>
                </li>
              ))}
            </ol>
          ) : (
            <p class="border-t border-hairline pt-4 text-muted">
              첫 글을 준비하고 있어요. <a href="/rss.xml">RSS</a>로 구독해 두면 새 글이 올라올 때 받아볼 수 있습니다.
            </p>
          )
        }
      </section>

      <Footer />
    </main>

    <aside
      class="home-visual sticky top-[clamp(40px,6vw,64px)] hidden flex-[0_0_340px] min-[960px]:block"
      aria-hidden="true"
    >
      <div class="relative h-[650px] w-[340px] overflow-hidden rounded-[14px] border border-hairline bg-[#86b9e6]">
        <HomePainting />
      </div>
    </aside>
  </div>
</Layout>
