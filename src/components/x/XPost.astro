---
import type { XEntry } from "@lib/x";
import { formatLongDate, linkify } from "@lib/x";
import XLogo from "./XLogo.astro";

interface Props {
  post: XEntry["data"]["post"];
}

const { post } = Astro.props;
const { author } = post;
---

<section class="px-5 pt-5 pb-4 font-sans">
  <header class="flex items-center gap-3">
    <img
      src={author.avatar}
      alt=""
      width="44"
      height="44"
      class="size-11 flex-none rounded-full border border-hairline"
    />
    <span class="flex min-w-0 flex-col leading-snug">
      <span class="flex items-center gap-1 text-[15px] font-semibold text-ink">
        <span class="truncate">{author.name}</span>
        {
          author.verified && (
            <svg role="img" aria-label="인증된 계정" width="15" height="15" viewBox="0 0 24 24" class="flex-none">
              <path
                d="M12 1.8l2.4 1.8 3-.2 1 2.8 2.6 1.6-.6 2.9 1.4 2.6-2 2.2-.1 3-2.9.8-1.6 2.6-2.9-.6L12 22.2l-2.4-1.8-2.9.6-1.6-2.6-2.9-.8-.1-3-2-2.2 1.4-2.6-.6-2.9 2.6-1.6 1-2.8 3 .2z"
                fill="currentColor"
              />
              <path
                d="M8 12.2l2.7 2.7L16.4 9"
                fill="none"
                stroke="var(--color-canvas)"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          )
        }
      </span>
      <span class="text-sm text-muted">@{author.handle}</span>
    </span>
    <a href={post.url} aria-label="X에서 원글 보기" class="ml-auto self-start text-ink">
      <XLogo size={18} />
    </a>
  </header>

  <p class="mt-3.5 text-base leading-relaxed whitespace-pre-line text-ink [overflow-wrap:anywhere]">
    {linkify(post.text).map((s) => (s.href ? <a href={s.href} class="text-link hover:text-ink">{s.text}</a> : s.text))}
  </p>

  {
    post.media.slice(0, 4).map((m) => (
      <a href={post.url} class="relative mt-3.5 block overflow-hidden rounded-xl border border-hairline bg-canvas-soft">
        <img
          src={m.src}
          alt=""
          width={m.width}
          height={m.height}
          class="block max-h-[420px] w-full object-cover"
          style={`aspect-ratio: ${m.width} / ${m.height}`}
        />
        {m.type === "video" && (
          <span class="absolute inset-0 grid place-items-center">
            <span class="grid size-14 place-items-center rounded-full bg-black/60 text-white">
              <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                <path d="M8 5.5v13l11-6.5z" />
              </svg>
            </span>
            <span class="sr-only">X에서 영상 보기</span>
          </span>
        )}
      </a>
    ))
  }

  <p class="mt-3.5 flex flex-wrap gap-1.5 text-[13px] leading-snug text-muted">
    <time datetime={post.createdAt.toISOString()}>{formatLongDate(post.createdAt)}</time>
    <span aria-hidden="true">·</span>
    <a href={post.url}>X에서 보기</a>
  </p>
</section>
