---
import type { XEntry } from "@lib/x";
import { site } from "@shared/constants";
import XPost from "./XPost.astro";
import XRow from "./XRow.astro";

interface Props {
  entry: XEntry;
}

// The saved post, then Dan's replies joined to it by the avatar line.
const { post, replies } = Astro.props.entry.data;
---

<article>
  <XPost post={post} threaded={replies.length > 0} />
  {
    replies.map((reply, i) => (
      <XRow
        avatar={site.avatarUrl}
        name={site.author}
        handle={site.handle.replace(/^@/, "")}
        date={reply.date}
        threaded={i < replies.length - 1}
      >
        <p class="whitespace-pre-line [overflow-wrap:anywhere]">{reply.text}</p>
      </XRow>
    ))
  }
</article>
