---
import type { XEntry } from "@lib/x";
import { formatShortDate } from "@lib/x";
import { site } from "@shared/constants";
import XPost from "./XPost.astro";

interface Props {
  entry: XEntry;
}

const { post, replies } = Astro.props.entry.data;
---

<article class="rounded-2xl border border-hairline">
  <XPost post={post} />

  {
    replies.length > 0 && (
      <div class="border-t border-hairline px-5 pt-[18px] pb-1.5">
        {replies.map((reply, i) => (
          <div class="grid grid-cols-[36px_minmax(0,1fr)] gap-x-3">
            <div class="flex flex-col items-center">
              <img
                src={site.avatarUrl}
                alt=""
                width="36"
                height="36"
                class="size-9 flex-none rounded-full border border-hairline"
              />
              {i < replies.length - 1 && <span aria-hidden="true" class="mt-1.5 mb-1 w-0.5 flex-1 rounded-full bg-hairline" />}
            </div>
            <div class="pb-[18px]">
              <p class="flex flex-wrap items-baseline gap-1.5 font-sans text-sm leading-snug text-muted">
                <span class="text-[15px] font-semibold text-ink">{site.author}</span>
                <span>{site.handle}</span>
                <span aria-hidden="true">·</span>
                <time datetime={reply.date.toISOString()}>{formatShortDate(reply.date)}</time>
              </p>
              <p class="mt-1.5 whitespace-pre-line">{reply.text}</p>
            </div>
          </div>
        ))}
      </div>
    )
  }
</article>
