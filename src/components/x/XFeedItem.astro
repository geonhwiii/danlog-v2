---
import type { XEntry } from "@lib/x";
import { formatShortDate, summaryOf } from "@lib/x";
import XLogo from "./XLogo.astro";

interface Props {
  entry: XEntry;
}

const { entry } = Astro.props;
---

<li class="border-b border-hairline">
  <a href={`/x/${entry.id}`} class="group/row flex items-start gap-3 py-3.5 text-ink no-underline">
    <span class="flex min-w-0 flex-1 flex-col gap-1.5">
      <span class="line-clamp-2 leading-relaxed decoration-1 underline-offset-[0.26em] group-hover/row:underline">
        {summaryOf(entry)}
      </span>
      <span class="flex items-center gap-1.5 font-sans text-[13px] leading-snug text-muted">
        <XLogo size={11} />
        <span>@{entry.data.post.author.handle}</span>
        <span aria-hidden="true">·</span>
        <time datetime={entry.data.post.createdAt.toISOString()}>{formatShortDate(entry.data.post.createdAt)}</time>
      </span>
    </span>
    <svg
      aria-hidden="true"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="mt-1.5 flex-none text-muted transition-transform duration-200 group-hover/row:translate-x-0.5"
    >
      <path d="m9 18 6-6-6-6"></path>
    </svg>
  </a>
</li>
