---
import { formatLongDate, formatShortDate } from "@lib/x";
import XActions from "./XActions.astro";
import XLogo from "./XLogo.astro";

interface Props {
  avatar: string;
  name: string;
  /** Without the leading @. */
  handle: string;
  verified?: boolean;
  date: Date;
  /** The original post on X — linked from the date and the X mark. */
  url?: string;
  /** Draw the thread line down to the next row, like an X self-thread. */
  threaded?: boolean;
}

// One timeline row in X's layout: avatar column on the left (with the thread
// line), name · @handle · date on one line, then the body from the slot.
const { avatar, name, handle, verified = false, date, url, threaded = false } = Astro.props;
---

<div class="grid grid-cols-[40px_minmax(0,1fr)] gap-x-3 px-4 pt-3">
  <div class="flex flex-col items-center">
    <img src={avatar} alt="" width="40" height="40" class="size-10 flex-none rounded-full bg-surface-strong" />
    {threaded && <span aria-hidden="true" class="mt-1 w-0.5 flex-1 bg-hairline-strong" />}
  </div>

  <div class:list={["min-w-0 font-sans", threaded ? "pb-3" : "pb-1"]}>
    <header class="flex items-center gap-1 text-[15px] leading-5">
      <span class="truncate font-bold text-ink">{name}</span>
      {
        verified && (
          <svg role="img" aria-label="인증된 계정" width="18" height="18" viewBox="0 0 22 22" class="flex-none text-[#1d9bf0]">
            <path
              d="M20.396 11c-.018-.646-.215-1.275-.57-1.816-.354-.54-.852-.972-1.438-1.246.223-.607.27-1.264.14-1.897-.131-.634-.437-1.218-.882-1.687-.47-.445-1.053-.75-1.687-.882-.633-.13-1.29-.083-1.897.14-.273-.587-.704-1.086-1.245-1.44S11.647 1.62 11 1.604c-.646.017-1.273.213-1.813.568s-.969.854-1.24 1.44c-.608-.223-1.267-.272-1.902-.14-.635.13-1.22.436-1.69.882-.445.47-.749 1.055-.878 1.688-.13.633-.08 1.29.144 1.896-.587.274-1.087.705-1.443 1.245-.356.54-.555 1.17-.574 1.817.02.647.218 1.276.574 1.817.356.54.856.972 1.443 1.245-.224.606-.274 1.263-.144 1.896.13.634.433 1.218.877 1.688.47.443 1.054.747 1.687.878.633.132 1.29.084 1.897-.136.274.586.705 1.084 1.246 1.439.54.354 1.17.551 1.816.569.647-.016 1.276-.213 1.817-.567s.972-.854 1.245-1.44c.604.239 1.266.296 1.903.164.636-.132 1.22-.447 1.68-.907.46-.46.776-1.044.908-1.681s.075-1.299-.165-1.903c.586-.274 1.084-.705 1.439-1.246.354-.54.551-1.17.569-1.816zM9.662 14.85l-3.429-3.428 1.293-1.302 2.072 2.072 4.4-4.794 1.347 1.246z"
              fill="currentColor"
            />
          </svg>
        )
      }
      <span class="flex min-w-0 items-center gap-1 text-muted">
        <span class="truncate">@{handle}</span>
        <span aria-hidden="true">·</span>
        {
          url ? (
            <a href={url} class="flex-none text-muted no-underline hover:underline">
              <time datetime={date.toISOString()} title={formatLongDate(date)}>{formatShortDate(date)}</time>
            </a>
          ) : (
            <time datetime={date.toISOString()} title={formatLongDate(date)} class="flex-none">
              {formatShortDate(date)}
            </time>
          )
        }
      </span>
      {
        url && (
          <a href={url} aria-label="X에서 원글 보기" class="-my-1 -mr-1.5 ml-auto grid size-8 flex-none place-items-center rounded-full text-muted transition-colors hover:bg-surface-strong hover:text-ink">
            <XLogo size={15} />
          </a>
        )
      }
    </header>

    <div class="mt-0.5 text-[15px] leading-5 text-ink">
      <slot />
    </div>

    <XActions />
  </div>
</div>
