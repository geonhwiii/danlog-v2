---
import { site } from "@shared/constants";

interface Props {
  /** Show a "← 모든 글" link home instead of the copyright line. */
  back?: boolean;
}

const { back = false } = Astro.props;
---

<footer
  class:list={[
    "flex flex-wrap justify-between gap-x-6 gap-y-2 font-sans text-sm leading-normal text-muted",
    back ? "mt-20 border-t border-hairline pt-5" : "mt-24",
  ]}
>
  {back ? <a href="/" class="quiet-link">← 모든 글</a> : <span>© {new Date().getFullYear()} {site.author}</span>}
  <span class="flex gap-4">
    <a href="/rss.xml">RSS</a>
    <a href={site.githubUrl}>GitHub</a>
  </span>
</footer>
